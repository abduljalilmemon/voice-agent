# Copy to .env and fill in. Only the keys for the providers you choose are needed.
# Keep comments on their own lines: .env is read by both python-dotenv and docker compose.

# ── LLM ────────────────────────────────────────────────────────
# Provider: groq | anthropic | openai | gemini
LLM_PROVIDER=groq
# Optional model override. Defaults: groq openai/gpt-oss-20b, anthropic claude-haiku-5-5
# LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Claude thinking effort; low keeps spoken replies fast
# ANTHROPIC_EFFORT=low

# ── Voice ──────────────────────────────────────────────────────
# Speech-to-text
DEEPGRAM_API_KEY=
# Text-to-speech: edge (free, no key) | elevenlabs | openai
TTS_PROVIDER=edge
# EDGE_VOICE=en-US-JennyNeural
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# OPENAI_VOICE=nova

# ── Booking notifications (Gmail app password) ─────────────────
# Who receives new-booking emails
OWNER_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Security ───────────────────────────────────────────────────
# Required X-API-Key header for GET /bookings -- use a long random string
ADMIN_API_KEY=
# Extra browser origins allowed to call the API (the bundled frontend needs none)
# CORS_ORIGINS=https://example.com
# Agent turns per minute per client IP
# RATE_LIMIT_PER_MINUTE=20

# ── Operations ─────────────────────────────────────────────────
# DEBUG also logs messages, transcripts and booking data
# LOG_LEVEL=INFO
# Where memory.db and bookings.db live (a volume in Docker)
# STORAGE_DIR=.
# Knowledge-base relevance cut-off
# RAG_MAX_DISTANCE=0.88
